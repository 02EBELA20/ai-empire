{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@economy": [
        "./packages/economy/src/index.ts"
      ],
      "@sim": [
        "./packages/sim/src/index.ts"
      ],
      "@save": [
        "./packages/save/src/index.ts"
      ],
      "@data/*": [
        "./packages/data/*"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "vite.config.ts"
  ]
}
